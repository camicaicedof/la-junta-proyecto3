{
  "name": "natillera-comunitaria",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": "24.x" },
  "scripts": {
    "compile": "node scripts/hardhat.js compile",
    "test": "node scripts/hardhat.js test",
    "node": "node scripts/hardhat.js node",
    "deploy:local": "node scripts/hardhat.js run scripts/deploy.js --network localhost",
    "deploy:sepolia": "node scripts/hardhat.js run scripts/deploy.js --network sepolia",
    "setup:sepolia": "node scripts/setup-sepolia.js",
    "demo": "node scripts/hardhat.js run scripts/demo.js",
